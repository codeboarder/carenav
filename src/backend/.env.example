# Azure OpenAI Configuration (BYOK mode for Copilot SDK)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# Model Deployments
MODEL_GPT_5_2=gpt-5.2
MODEL_GPT_5_NANO=gpt-5-nano
MODEL_EMBEDDING=text-embedding-ada-002

# Azure AI Search (optional - for enhanced facility search)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-key-here

# Azure AI Foundry (optional - for advanced AI capabilities)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project
AZURE_AI_FOUNDRY_API_KEY=your-foundry-key-here

# Database
DATABASE_URL=sqlite:///./carenav.db

# ChromaDB (optional - for RAG)
CHROMA_ENABLED=false

# GitHub Copilot SDK (used when provider is set to copilot_sdk)
# Requires Copilot CLI installed and authenticated
# COPILOT_CLI_PORT=4321
