# ============================================================
# CareNav Florida — Environment Configuration
# Built by Gregory Katz and Rick Weyenberg
# Code is as-is, open source
# ============================================================

# Azure OpenAI (BYOK mode — required for both Azure and Copilot SDK)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Model Deployments
MODEL_GPT_5_2=gpt-5.2
MODEL_GPT_5_NANO=gpt-5-nano
MODEL_EMBEDDING=text-embedding-3-large

# ============================================================
# DATA LAYER — Choose ONE of each pair
# ============================================================

# OPTION A: SQLite (current — local development)
DATABASE_URL=sqlite+aiosqlite:///./carenav.db

# OPTION B: Azure SQL Database (target — uncomment after provisioning)
# AZURE_SQL_SERVER=carenav-sql-server.database.windows.net
# AZURE_SQL_DATABASE=carenav-db
# AZURE_SQL_USERNAME=carenavadmin
# AZURE_SQL_PASSWORD=your-strong-password

# ============================================================
# VECTOR SEARCH — Choose ONE
# ============================================================

# OPTION A: ChromaDB (current — local development)
CHROMA_ENABLED=false

# OPTION B: Azure AI Search (target — uncomment after provisioning)
# AZURE_SEARCH_ENDPOINT=https://carenav-search.search.windows.net
# AZURE_SEARCH_API_KEY=your-search-admin-key
# AZURE_SEARCH_INDEX=carenav-documents

# ============================================================
# FOUNDRY IQ (15 bonus points — uncomment after setup)
# ============================================================
# FOUNDRY_IQ_KNOWLEDGE_BASE_ID=carenav-knowledge
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project
# AZURE_AI_FOUNDRY_API_KEY=your-foundry-key

# ============================================================
# LLM PROVIDER — Change to copilot_sdk after SDK integration
# ============================================================
LLM_PROVIDER=azure
# COPILOT_CLI_PORT=4321
